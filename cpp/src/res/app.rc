#include <windows.h>

// SuperClip 资源（技术方案 §10.2）
// 图标：M5 出包时补 SuperClip.ico（16/24/32/48/256 多尺寸）并解开下一行；
// 当前缺图标资源，托盘按 §5.4 的回退链使用系统应用图标。
// IDI_APP ICON "SuperClip.ico"

1 24 "app.manifest"        // RT_MANIFEST：DPI 感知 + 兼容性 + comctl6

// 版本号写死为字面量：windres/RC.exe 对 FILEVERSION 的宏展开行为不一致，
// 且 PackageRelease.bat 以正则抓取 FILEVERSION 行作为发版来源。
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,2,0
 PRODUCTVERSION 2,0,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"          // 简体中文 / Unicode 代码页
    BEGIN
      VALUE "CompanyName",  "SuperClip"
      VALUE "FileDescription", "SuperClip 超级剪贴板"
      VALUE "FileVersion",  "2.0.2.0"
      VALUE "InternalName", "SuperClip"
      VALUE "LegalCopyright", "Copyright © SuperClip"
      VALUE "OriginalFilename", "SuperClip.exe"
      VALUE "ProductName",  "SuperClip 超级剪贴板"
      VALUE "ProductVersion", "2.0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
